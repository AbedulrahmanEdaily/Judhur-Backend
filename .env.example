# Copy this file to .env and fill in the values. Never commit .env.
# Nested settings use a double underscore: JwtSettings:Secret -> JwtSettings__Secret

# Local development only: password of the HTTPS development certificate (dotnet dev-certs https -ep ... -p <this value>)
CERT_PASSWORD=

# SQL Server container (sa password: 8+ chars, upper, lower, digit; no ';' or '$')
MSSQL_SA_PASSWORD=

# JWT
JwtSettings__Issuer=
JwtSettings__Audience=
JwtSettings__Secret=
JwtSettings__TokenExpirationInMinutes=
JwtSettings__RefreshTokenExpirationInDays=

# Cloudinary
CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=

# Gmail app password for the sender in appsettings.json (Email section)
EmailPassword=

# MediatR
MediatR__LicenseKey=

# Server only (Development takes these from appsettings.Development.json)
Cors__AllowedOrigins__0=
Frontend__ConfirmEmailUrl=
Frontend__ConfirmEmailChangeUrl=
Google__ClientId=

# Server only, first start: the admin account created when no admin exists
AdminSeed__Email=
AdminSeed__Password=
AdminSeed__FullName=
AdminSeed__City=

# Optional: networks of the reverse proxy allowed to set X-Forwarded-For (empty trusts any sender,
# which is safe only while the API port is bound to 127.0.0.1 as in docker-compose.yml)
ForwardedHeaders__KnownNetworks__0=

# Set to false when the deployment applies migrations itself (dotnet ef migrations script --idempotent)
Database__ApplyMigrationsOnStartup=true
